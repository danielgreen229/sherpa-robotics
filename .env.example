# Port exposed by Nginx. Open http://localhost:8080
APP_PORT=8080
# Use URL-safe letters, numbers and underscores in DB/broker credentials.
DB_NAME=catalog
DB_USER=catalog
DB_PASSWORD=catalog_local_password
RABBITMQ_USER=catalog
RABBITMQ_PASSWORD=catalog_queue_password
# setup.sh replaces this placeholder with a random 64-character secret.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
# Initial user (created if absent; changing this does not reset an existing password).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CatalogDemo2026!
# Imports per authenticated user per minute.
IMPORT_RATE_LIMIT=5
# Compose builds DATABASE_URL and MESSENGER_TRANSPORT_DSN from the fields above.
# For a native PHP launch, export these separately:
# DATABASE_URL=postgresql://catalog:catalog_local_password@127.0.0.1:5432/catalog
# MESSENGER_TRANSPORT_DSN=amqp://catalog:catalog_queue_password@127.0.0.1:5672/%2f/catalog_imports
# STORAGE_PATH=/absolute/path/to/backend/var
# MAX_UPLOAD_MB=10
