{
  "name": "daniel/product-importer",
  "description": "Asynchronous XLSX product catalog built with Slim and Doctrine",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-amqp": "*",
    "ext-bcmath": "*",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-zip": "*",
    "doctrine/dbal": "^4.2",
    "doctrine/migrations": "^3.9",
    "doctrine/orm": "^3.3",
    "firebase/php-jwt": "^7.2",
    "phpoffice/phpspreadsheet": "^5.0",
    "slim/psr7": "^1.8",
    "slim/slim": "^4.14",
    "symfony/amqp-messenger": "^7.4",
    "symfony/cache": "^7.4",
    "symfony/console": "^7.4",
    "symfony/dotenv": "^7.4",
    "symfony/messenger": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.75"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=512M",
    "style": "php-cs-fixer fix --dry-run --diff",
    "format": "php-cs-fixer fix"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  },
  "license": "proprietary"
}
